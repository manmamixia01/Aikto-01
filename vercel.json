{
  "rewrites": [
    {
      "source": "/animation",
      "destination": "/animation/index.html"
    },
    {
      "source": "/animation/",
      "destination": "/animation/index.html"
    },
    {
      "source": "/ar",
      "destination": "/ar/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/ar/index.html"
    },
    {
      "source": "/ar-admin",
      "destination": "/ar-admin/index.html"
    },
    {
      "source": "/ar-admin/",
      "destination": "/ar-admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
